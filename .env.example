# RentEasy local environment.
#
# Copy this file to `.env` in the repository root (it is loaded by `just` and `run.sh`) or export the same variables before starting the apps.

# --- ABA PayWay (Ecommerce Checkout) ---------------------------------------
# 
# Sandbox credentials are emailed after registering at https://sandbox.payway.com.kh/register-sandbox/. Production credentials are issued by PayWay sales.

# Optional fallback; the admin can set the merchant ID in their Profile.
ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_API_KEY=
ABA_PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh

# Set to false to disable ABA PayWay checkout.

ABA_PAYWAY_ENABLED=true

# Empty lets PayWay show every method enabled on the merchant profile.
# Examples: cards, abapay_khqr, alipay, wechat, google_pay.

ABA_PAYWAY_PAYMENT_OPTION=
ABA_PAYWAY_CURRENCY=USD
ABA_PAYWAY_LIFETIME_MINUTES=30
ABA_PAYWAY_TIMEOUT_SECONDS=15

# --- Rent hold / owner payouts ----------------------------------------------
# Number of days the platform holds rent before an owner payout becomes due.

RENT_HOLD_DAYS=7

# --- Google OAuth 2.0 Authentication ---------------------------------------
#
# Create credentials in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# 1. Create an OAuth 2.0 Client ID (Application type: Web application)
# 2. Add Authorized JavaScript origins:
#      http://localhost:4200
#      http://127.0.0.1:8123
# 3. Add Authorized redirect URIs:
#      http://localhost:4200/api/auth/google/callback/
#      http://localhost:4200/auth/google/callback
#      http://127.0.0.1:8123/auth/google/callback/
# 4. Paste Client ID and Client Secret below:
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: override redirect URI if not using the default proxy pattern
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4200/api/auth/google/callback/

# --- SMTP Email Configuration ------------------------------------------------
# For production or sending real verification emails via Gmail, Resend, Sendgrid, etc.
# If EMAIL_HOST_USER is blank, Django uses console backend in DEBUG mode and logs OTPs.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=RentEasy <noreply@renteasy.com>

# --- Browser / callback URLs ------------------------------------------------

FRONTEND_BASE_URL=http://localhost:4200
BACKEND_PUBLIC_URL=http://127.0.0.1:8123

# For a sandbox test with server-to-server callbacks, expose the backend with a
# tunnel and use its public HTTPS URL above, for example:
#   cloudflared tunnel --url http://127.0.0.1:8123
# BACKEND_PUBLIC_URL=https://<random>.trycloudflare.com
#
# The two callback URLs default to the values below and only need overriding
# when they do not follow the BACKEND_PUBLIC_URL pattern.
# ABA_PAYWAY_CALLBACK_URL=https://<tunnel>/payments/aba/callback/
# ABA_PAYWAY_RETURN_URL=https://<tunnel>/payments/aba/return/?payment={payment_id}
# ABA_PAYWAY_CANCEL_URL=http://localhost:4200/bookings
#
# PayWay requires the callback domain to be whitelisted in the merchant
# profile. For a browser-only local test, set the callback to an empty value so
# the form omits return_url; PayWay then uses the profile default.
# ABA_PAYWAY_CALLBACK_URL=

# --- AI (owner property draft and description generator) ---------------------
# Set AI_PROVIDER to "gemini" or "groq". If omitted, Gemini is selected when
# GEMINI_API_KEY is configured; otherwise Groq is used.
AI_PROVIDER=
# Server-side only. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Server-side only. Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Telegram login + notifications ------------------------------------------
# Create a bot with @BotFather and set its token and username.
# Sign-in uses a bot deep link: the site opens https://t.me/<bot>?start=<token>,
# the bot replies with a one-time 6-digit code, and the user enters it on the site.
# Set a random TELEGRAM_WEBHOOK_SECRET, then run `just telegram-webhook` (after
# the backend is publicly reachable) to register the webhook with Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/telegram/webhook/
TELEGRAM_CHAT_ID=
