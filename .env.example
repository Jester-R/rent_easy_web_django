# RentEasy local environment.
#
# Copy this file to `.env` in the repository root (it is loaded by `just` and `run.sh`) or export the same variables before starting the apps.
#
# Integration credentials (ABA, Stripe, Google, Telegram) are configured in
# Console -> Settings by a superadmin and stored in the database. Saved values
# override the environment, so keys and tokens can be rotated without editing
# this file or restarting the backend. Advanced deployments can still export
# matching variables as fallbacks, but they are intentionally not listed here.

# --- Host and CSRF security -------------------------------------------------
# Comma-separated hostnames accepted by Django. `just` and `run.sh` also pass
# this list to Angular SSR and the dev server.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,[::1],myapp.asse.devtunnels.ms

# Comma-separated full browser origins (scheme + host + optional port) allowed
# to send unsafe requests such as POST. Add the frontend/public domain here.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:4000,http://127.0.0.1:4000,http://localhost:4200,http://127.0.0.1:4200,https://myapp.asse.devtunnels.ms

# --- ABA PayWay (Ecommerce Checkout) ---------------------------------------
# 
# Sandbox credentials are emailed after registering at https://sandbox.payway.com.kh/register-sandbox/. Production credentials are issued by PayWay sales.

# Merchant ID and API key are configured in Console -> Settings.
ABA_PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh

# Set to false to disable ABA PayWay checkout.

ABA_PAYWAY_ENABLED=true

# Empty lets PayWay show every method enabled on the merchant profile.
# Examples: cards, abapay_khqr, alipay, wechat, google_pay.

ABA_PAYWAY_PAYMENT_OPTION=
ABA_PAYWAY_CURRENCY=USD
ABA_PAYWAY_LIFETIME_MINUTES=30
ABA_PAYWAY_TIMEOUT_SECONDS=15

# --- Stripe (hosted card checkout) -------------------------------------------
# Test mode ("sandbox"): create a Stripe account, switch to Test mode, and copy
# the keys from Developers > API keys. With an sk_test_... key the checkout page
# accepts the documented test cards, e.g. 4242 4242 4242 4242 (any future
# expiry / CVC). No real money moves.
# Webhooks: Developers > Webhooks > Add endpoint -> http://127.0.0.1:8000/payments/stripe/webhook/
# (use an ngrok/cloudflared URL in local development), events:
# checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired

# Secret key, publishable key, and webhook signing secret are configured in
# Console -> Settings.
STRIPE_ENABLED=true
STRIPE_CURRENCY=usd
STRIPE_SESSION_MINUTES=30
STRIPE_TIMEOUT_SECONDS=15

# --- Rent hold / owner payouts ----------------------------------------------
# Number of days the platform holds rent before an owner payout becomes due.

RENT_HOLD_DAYS=7

# --- Google OAuth 2.0 Authentication ---------------------------------------
#
# Create credentials in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# 1. Create an OAuth 2.0 Client ID (Application type: Web application)
# 2. Add Authorized JavaScript origins:
#      http://localhost:4200
#      http://127.0.0.1:8123
# 3. Add Authorized redirect URIs:
#      http://localhost:4200/api/auth/google/callback/
#      http://localhost:4200/auth/google/callback
#      http://127.0.0.1:8123/auth/google/callback/
# 4. Save the Client ID and Client Secret in Console -> Settings. In production,
#    use https://<your-domain>/api/auth/google/callback/ and let nginx forward
#    /api to Django instead of relying on the Angular dev-server proxy.

# --- SMTP Email Configuration ------------------------------------------------
# For production or sending real verification emails via Gmail, Resend, Sendgrid, etc.
# If EMAIL_HOST_USER is blank, Django uses console backend in DEBUG mode and logs OTPs.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="RentEasy <noreply@renteasy.com>"

FRONTEND_BASE_URL=http://localhost:4000
BACKEND_PUBLIC_URL=http://127.0.0.1:8000

# For a sandbox test with server-to-server callbacks, expose the backend with a
# tunnel and use its public HTTPS URL above, for example:
#   cloudflared tunnel --url http://127.0.0.1:8123
# BACKEND_PUBLIC_URL=https://<random>.trycloudflare.com
#
# The two callback URLs default to the values below and only need overriding
# when they do not follow the BACKEND_PUBLIC_URL pattern.
# ABA_PAYWAY_CALLBACK_URL=https://<tunnel>/payments/aba/callback/
# ABA_PAYWAY_RETURN_URL=https://<tunnel>/payments/aba/return/?payment={payment_id}
# ABA_PAYWAY_CANCEL_URL=http://localhost:4200/bookings
#
# PayWay requires the callback domain to be whitelisted in the merchant
# profile. For a browser-only local test, set the callback to an empty value so
# the form omits return_url; PayWay then uses the profile default.
# ABA_PAYWAY_CALLBACK_URL=

# --- AI (owner property draft and description generator) ---------------------
# Set AI_PROVIDER to "gemini" or "groq". If omitted, Gemini is selected when
# GEMINI_API_KEY is configured; otherwise Groq is used.
AI_PROVIDER=

# Server-side only. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Server-side only. Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Telegram login + notifications ------------------------------------------
# Create a bot with @BotFather, then save the bot token, username, webhook
# secret, webhook URL, and optional admin chat ID in Console -> Settings.
# Sign-in uses a bot deep link: the site opens https://t.me/<bot>?start=<token>,
# the bot replies with a one-time 6-digit code, and the user enters it on the site.
# Use the "Register webhook" button after saving so Telegram sends updates.

# --- Database & Media Storage ------------------------------------------------
# Paths for SQLite database and uploaded media files.
# If omitted or running via run.sh, these point to backend/db.sqlite3 and backend/media.
SQLITE_PATH=backend/db.sqlite3
MEDIA_PATH=backend/media

# --- Optional runtime overrides ---------------------------------------------
# Django deployment/TLS behind a reverse proxy.
# DJANGO_SECRET_KEY=replace-with-a-long-random-string
# DJANGO_PRODUCTION=1
# TRUST_FORWARDED_PROTO=1
#
# Frontend SSR process (node dist/frontend/server/server.mjs).
# PORT=4200
# BACKEND_URL=http://127.0.0.1:8000
#
# Optional callback overrides (defaults derive from the URLs above).
# STRIPE_RETURN_URL=https://your-domain.com/api/payments/stripe/return/?payment={payment_id}
# STRIPE_CANCEL_URL=https://your-domain.com/bookings

