{
  "name": "rent-easy-web-assets",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CSS build pipeline for RentEasy Web (Django)",
  "scripts": {
    "build:css": "tailwindcss -i ./tools/tailwind/input.css -o ./static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./tools/tailwind/input.css -o ./static/css/app.css --watch",
    "vendor:jquery": "node tools/vendor/jquery.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "4.3.3"
  },
  "dependencies": {
    "jquery": "4.0.0"
  }
}
